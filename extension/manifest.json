{
  "manifest_version": 3,
  "name": "Lorestep for Chrome",
  "short_name": "Lorestep",
  "version": "0.10.0",
  "key": "",
  "description": "Mark posters on Netflix, Prime Video, JioHotstar, ZEE5, HBO Max and Crunchyroll, and sync the list to Lorestep.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "contextMenus", "alarms", "identity"],
  "host_permissions": [
    "https://lorestep.akshitbansal.dev/*",
    "https://ep-noisy-king-bbgaaffj.neonauth.c-15.us-east-1.aws.neon.tech/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lorestep library",
    "default_popup": "library/library.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/netflix.js", "core/scan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.in/gp/video/*",
        "https://www.amazon.co.uk/gp/video/*",
        "https://www.amazon.de/gp/video/*",
        "https://www.amazon.co.jp/gp/video/*"
      ],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/primevideo.js", "core/scan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hotstar.com/*", "https://www.jiohotstar.com/*"],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/hotstar.js", "core/scan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zee5.com/*"],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/zee5.js", "core/scan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.hbomax.com/*", "https://play.max.com/*"],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/hbomax.js", "core/scan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["core/states.js", "core/store.js", "core/ui.js", "adapters/crunchyroll.js", "core/scan.js"],
      "run_at": "document_idle"
    }
  ]
}
