# --- Neon (Postgres) --------------------------------------------------------
# The canon and screen datasets. Copy the pooled connection string from the Neon
# dashboard. Server-side only: it is never NEXT_PUBLIC_ and must never reach the
# browser. `npm run data:seed` reads it to create the tables and load the
# authored JSON. `npm run db:migrate` reads it to apply db/migrations, and refuses
# a non-localhost host outside CI unless given --allow-remote, and refuses any
# branch where Neon Auth is not enabled (0002 references neon_auth."user").
DATABASE_URL=

# --- Neon Auth (managed Better Auth) ------------------------------------------
# Read on first use, never at build. The base URL is the Auth URL from the Neon
# Console Auth page (path-based, ends in /neondb/auth); the sync routes fetch its
# /.well-known/jwks.json to verify Dogear tokens. The cookie secret signs the
# session-data cookie: 32+ characters, `openssl rand -base64 32`. Neon sends the
# auth mail and holds the OAuth provider secrets, so no mail or provider keys
# live here (BETTER_AUTH_*, GITHUB_*, GOOGLE_*, RESEND_API_KEY, MAIL_FROM are gone).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Optional. The `iss` of a Dogear access token; defaults to NEON_AUTH_BASE_URL.
NEON_AUTH_ISSUER=
# The OAuth client id Neon issued to the Dogear extension. A bearer token whose
# `client_id` differs is refused. Production value (public, not a secret):
# QHsrHeWAKSsEaVpDisiAwJBAdMXtMNvX
DOGEAR_OAUTH_CLIENT_ID=
# The app's own origin (http://localhost:3001 in development). The CSRF Origin
# check compares to it, and the Dogear token audience is APP_ORIGIN/api/v1/sync.
# Replaces BETTER_AUTH_URL.
APP_ORIGIN=
# Comma list of sign-in buttons to show, from `github,google`. Neon holds the
# provider secrets; this only tells the UI which are enabled there.
AUTH_PROVIDERS=
# `true` once custom SMTP is set in Neon, so password reset can send mail.
AUTH_RESET=

# --- Vercel Cron --------------------------------------------------------------
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/purge (vercel.json).
# Without it the route answers 401 to every call, so nothing is ever purged. Generate it with
# `openssl rand -base64 32` and set it in the Vercel project's environment variables.
CRON_SECRET=

# --- Better Stack (observability) -------------------------------------------
# Wired but inert until set: a missing token means "not reporting", never a
# crash or failed calls from a visitor's browser.
#
# The errors token is a public application token — it says where reports go and
# grants nothing, which is why it may ship in the page. The source token is for
# Telemetry (logs), read by @logtail/next through the next.config wrapper.
NEXT_PUBLIC_BETTER_STACK_ERRORS_TOKEN=
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=

# Web analytics needs no variable at all. Vercel Web Analytics is enabled by the
# platform, has no key, and is readable through the Vercel API — which is the
# whole reason it replaced a dashboard-gated analytics key here.

# --- IsThereAnyDeal ---------------------------------------------------------
# Powers the "Update prices" button and scripts/enrich-data.mjs.
# Create one at https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# --- IGDB (via Twitch) ------------------------------------------------------
# Used by scripts/enrich-data.mjs to pull release years, ratings and runtimes.
# Register an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Metadata providers (search, metadata, resolve-link) ---------------------
# Each provider is optional: without its keys that provider is skipped and the
# routes answer from the rest. All server-side only; never NEXT_PUBLIC_.
# TMDB: either the v4 read-access token (preferred) or the v3 key.
TMDB_BEARER_TOKEN=
TMDB_API_KEY=
# OMDb (IMDb ratings): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# MyAnimeList client id (anime and manga): https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
# IGDB uses the IGDB_CLIENT_ID / IGDB_CLIENT_SECRET pair declared above.
